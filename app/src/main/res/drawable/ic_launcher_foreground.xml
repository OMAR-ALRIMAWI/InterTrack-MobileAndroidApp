<?xml version="1.0" encoding="utf-8"?>
<!--
  InterTrack launcher foreground = the official main_logo.png (blue mark + "InterTrack" wordmark),
  centred inside the adaptive-icon safe zone. The 2:3-ratio insets keep the logo's proportions so it
  is neither stretched nor clipped by circular/squircle masks.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/main_logo"
    android:insetLeft="29%"
    android:insetRight="29%"
    android:insetTop="18%"
    android:insetBottom="18%" />
