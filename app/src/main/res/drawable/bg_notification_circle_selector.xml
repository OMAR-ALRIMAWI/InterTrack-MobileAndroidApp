<?xml version="1.0" encoding="utf-8"?>
<!-- Selector for notification circle — pressed stays inside the oval, no rectangle -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"
        android:drawable="@drawable/bg_notification_circle_pressed" />
    <item android:state_focused="true"
        android:drawable="@drawable/bg_notification_circle_pressed" />
    <item android:drawable="@drawable/bg_notification_circle" />
</selector>
