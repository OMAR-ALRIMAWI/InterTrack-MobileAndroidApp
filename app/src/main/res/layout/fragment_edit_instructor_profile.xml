<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_rounded_top"
    android:clipToOutline="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp">

        <!-- Avatar circle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_circle_blue"
                android:gravity="center">
                <TextView
                    android:id="@+id/editInstProfInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="SS"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:text="Change Photo"
                android:textSize="12sp"
                android:textColor="#005FAF"
                android:textAllCaps="false"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#005FAF"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <!-- Form card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Full Name" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInstEditName"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:text="Dr. Sarah Smith"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Department" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInstEditDept"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:text="Computer Engineering"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="University" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInstEditUniversity"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:text="Istanbul Technical University"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Office Location" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInstEditOffice"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:text="EEB 3rd Floor, Room 312"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bio card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bio"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInstEditBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:text="Associate Professor specializing in software engineering, distributed systems, and AI-driven applications."
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:textColor="#111827" android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save Changes"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="#005FAF"
            app:strokeWidth="0dp"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
