<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_rounded_top"
    android:clipToOutline="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp">

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressInstHomeMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <!-- Error state -->
        <TextView
            android:id="@+id/tvInstHomeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textColor="#DC2626"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Main Content -->
        <LinearLayout
            android:id="@+id/instHomeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Summary stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp"
                    app:cardBackgroundColor="#EFF6FF" app:strokeWidth="1dp" app:strokeColor="#BFDBFE">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <TextView android:id="@+id/tvActiveCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="#0569bf" android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Active Students" android:textColor="#374151" android:textSize="11sp" android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp"
                    app:cardBackgroundColor="#FEF3C7" app:strokeWidth="1dp" app:strokeColor="#FDE68A">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <TextView android:id="@+id/tvPendingCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="#D97706" android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pending Reviews" android:textColor="#374151" android:textSize="11sp" android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp"
                    app:cardBackgroundColor="#F0FDF4" app:strokeWidth="1dp" app:strokeColor="#BBF7D0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <TextView android:id="@+id/tvCompletedCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="#16A34A" android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Completed" android:textColor="#374151" android:textSize="11sp" android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardCornerRadius="14dp" app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFF1F2" app:strokeWidth="1dp" app:strokeColor="#FECDD3">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <TextView android:id="@+id/tvRequestsCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="#E11D48" android:textSize="26sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="New Requests" android:textColor="#374151" android:textSize="11sp" android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- My Students section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Active Students"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tvInstStudentsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No active students yet."
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <!-- Student list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInstStudents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
