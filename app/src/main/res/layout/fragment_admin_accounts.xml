<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshAdminAccounts"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Search + filter bar (always visible) -->
    <LinearLayout
        android:id="@+id/filterBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Search field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxBackgroundMode="outline"
            app:hintTextColor="#9CA3AF"
            app:boxStrokeColor="#E2E8F0"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Search by name or email"
                android:inputType="textEmailAddress"
                android:textSize="14sp"
                android:textColor="#111827"
                android:imeOptions="actionSearch" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Role filter chips — Filter style supports isChecked toggle -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="6dp">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="All Roles"
                    android:textSize="12sp"
                    android:checked="true"
                    app:checkedIconVisible="false"
                    style="@style/Widget.InterTrack.FilterChip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStudents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="Students"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    style="@style/Widget.InterTrack.FilterChip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipInstructors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="Supervisors"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    style="@style/Widget.InterTrack.FilterChip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompanies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Companies"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    style="@style/Widget.InterTrack.FilterChip" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Status filter chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="10dp">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="All Status"
                    android:textSize="12sp"
                    android:checked="true"
                    app:checkedIconVisible="false"
                    style="@style/Widget.InterTrack.FilterChip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="Active"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    style="@style/Widget.InterTrack.FilterChip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="Pending"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    style="@style/Widget.InterTrack.FilterChip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusBlocked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blocked"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    style="@style/Widget.InterTrack.FilterChip" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Count + refresh row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvAccountsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#374151"
                android:textSize="13sp"
                tools:text="12 accounts" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshAccounts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Button.TextButton"
                android:text="Refresh"
                android:textAllCaps="false"
                android:textColor="#005FAF"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/accountsProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filterBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Account list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAccounts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filterBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_user_account" />

    <!-- Empty / no-results state -->
    <LinearLayout
        android:id="@+id/accountsEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filterBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvNoResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="No accounts found"
            android:textColor="#9CA3AF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Error state -->
    <LinearLayout
        android:id="@+id/accountsErrorState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filterBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvErrorAccounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#DC2626"
            android:textSize="14sp"
            tools:text="Could not load accounts." />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
