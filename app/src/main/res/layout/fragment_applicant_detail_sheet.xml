<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_content_rounded_top"
    android:paddingBottom="32dp">

    <!-- Drag indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="#CBD5E1"/>

    <!-- Student avatar + name row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_icon_circle_blue"
            android:gravity="center">
            <TextView
                android:id="@+id/tvApplicantInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="?"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvApplicantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvApplicantOfferTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="#64748B"
                android:textSize="12sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvApplicantStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pending"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Pending"
            android:textColor="#92400E"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F1F5F9"/>

    <!-- Details scroll area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="4dp">

            <!-- Email -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                    android:text="Email" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvApplicantEmail"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="—"
                    android:textColor="#0F172A" android:textSize="13sp"/>
            </LinearLayout>

            <!-- University -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                    android:text="University" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvApplicantUniversity"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="—"
                    android:textColor="#0F172A" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Major -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                    android:text="Major" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvApplicantMajor"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="—"
                    android:textColor="#0F172A" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Year -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                    android:text="Year" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvApplicantYear"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="—"
                    android:textColor="#0F172A" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Skills -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                    android:text="Skills" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvApplicantSkills"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="—"
                    android:textColor="#0F172A" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Applied date -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                    android:text="Applied" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvApplicantDate"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="—"
                    android:textColor="#0F172A" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Rejection reason -->
            <TextView
                android:id="@+id/tvApplicantRejectionReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:visibility="gone"/>

        </LinearLayout>

    </ScrollView>

    <!-- Accept / Reject buttons -->
    <LinearLayout
        android:id="@+id/llApplicantActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplicantAccept"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Accept"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:backgroundTint="#16A34A"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplicantReject"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Reject"
            android:textColor="#DC2626"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="#DC2626"
            app:strokeWidth="1dp"/>

    </LinearLayout>

</LinearLayout>
