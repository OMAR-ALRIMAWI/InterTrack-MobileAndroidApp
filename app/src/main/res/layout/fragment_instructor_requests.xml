<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshInstructorRequests"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_rounded_top"
    android:clipToOutline="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp">

        <!-- ── Pending Internship Connections section ─────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending Internship Connections"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Students awaiting your confirmation to start their internship"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/progressPendingConnections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNoPendingConnections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No pending internship connections."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPendingConnections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <!-- ── Supervisor Requests section ────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supervisor Requests"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Students requesting you as their academic supervisor"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressRequests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <!-- Error state -->
        <TextView
            android:id="@+id/tvRequestsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Could not load requests."
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Empty pending state -->
        <TextView
            android:id="@+id/tvPendingEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No pending requests."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Pending requests list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPendingRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <!-- Accepted students section header -->
        <TextView
            android:id="@+id/tvAcceptedSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accepted Students"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- No accepted students -->
        <TextView
            android:id="@+id/tvNoAcceptedStudents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No accepted students yet."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Accepted students list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAcceptedStudents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
