<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_rounded_top"
    android:clipToOutline="true"
    android:clipToPadding="false"
    android:paddingBottom="128dp"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp">

        <!-- Profile info section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PROFILE"
            android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold"
            android:layout_marginBottom="8dp" android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF" app:strokeWidth="1dp" app:strokeColor="#E2E8F0">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Change name -->
                <LinearLayout android:id="@+id/rowChangeName"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_blue" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_compose" app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Change Name" android:textColor="#0F172A" android:textSize="14sp"/>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right" app:tint="#9CA3AF" android:contentDescription="@null"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="64dp" android:background="#F1F5F9"/>

                <!-- Change email -->
                <LinearLayout android:id="@+id/rowChangeEmail"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_blue" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mail" app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Change Email" android:textColor="#0F172A" android:textSize="14sp"/>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right" app:tint="#9CA3AF" android:contentDescription="@null"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="64dp" android:background="#F1F5F9"/>

                <!-- Change password -->
                <LinearLayout android:id="@+id/rowChangePassword"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_orange" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lock" app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Change Password" android:textColor="#0F172A" android:textSize="14sp"/>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right" app:tint="#9CA3AF" android:contentDescription="@null"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notifications section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NOTIFICATIONS"
            android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold"
            android:layout_marginBottom="8dp" android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF" app:strokeWidth="1dp" app:strokeColor="#E2E8F0">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_green" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bell_blue" app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Push Notifications" android:textColor="#0F172A" android:textSize="14sp"/>
                    <Switch android:id="@+id/switchPushNotif"
                        android:layout_width="50dp" android:layout_height="50dp"
                        android:checked="true" android:theme="@style/Theme.MaterialComponents"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="64dp" android:background="#F1F5F9"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_green" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_notif_message" app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Email Notifications" android:textColor="#0F172A" android:textSize="14sp"/>
                    <Switch android:id="@+id/switchEmailNotif"
                        android:layout_width="50dp" android:layout_height="50dp"
                        android:checked="true" android:theme="@style/Theme.MaterialComponents"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Preferences section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PREFERENCES"
            android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold"
            android:layout_marginBottom="8dp" android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF" app:strokeWidth="1dp" app:strokeColor="#E2E8F0">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/rowLanguage"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_purple" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_university" app:tint="#FFFFFF" android:contentDescription="@null"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Language" android:textColor="#0F172A" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="English" android:textColor="#64748B" android:textSize="13sp"
                        android:layout_marginEnd="6dp"/>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right" app:tint="#9CA3AF" android:contentDescription="@null"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Danger zone -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAccount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Delete Account"
            android:textAllCaps="false"
            android:textColor="#DC2626"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FEE2E2"
            app:cornerRadius="14dp"
            app:strokeWidth="0dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
