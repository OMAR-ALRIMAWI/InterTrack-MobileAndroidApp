<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshInstructorReview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_rounded_top"
    android:clipToOutline="true"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Reports"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reports submitted by students you supervise"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressInstructorReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <!-- Error -->
        <TextView
            android:id="@+id/tvInstructorReviewError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Could not load reports."
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Empty -->
        <TextView
            android:id="@+id/tvInstructorReviewEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No reports submitted yet."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Reports list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInstructorReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
