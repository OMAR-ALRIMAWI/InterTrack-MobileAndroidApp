<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_content_rounded_top"
    android:clipToOutline="true">

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipSoftware"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Software Engineering"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_filter_chip_active"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipMechanical"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Mechanical"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipElectrical"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Electrical"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipBusiness"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Business"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipDesign"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Design"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressHub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvHubEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="No open internship offers available yet."
        android:textColor="#64748B"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Offers list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInternshipOffers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="128dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone" />

</LinearLayout>
