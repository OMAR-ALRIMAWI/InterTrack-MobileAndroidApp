<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_rounded_top"
    android:clipToOutline="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp">

        <!-- Logo/avatar row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_circle_blue"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="TC"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeCompLogo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:text="Change Logo"
                android:textSize="12sp"
                android:textColor="#005FAF"
                android:textAllCaps="false"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#005FAF"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <!-- Company info card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Company Information"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Company Name" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompName"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Enter your company name"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Industry" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompIndustry"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. Software, Fintech, Healthcare"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Location" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompLocation"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="City, Country"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Contact Email" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompEmail"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="intern@company.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Company Description"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:hint="Describe your company, culture, and what interns will experience..."
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCompProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:text="Save Changes"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="#005FAF"
            app:strokeWidth="0dp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelCompProfile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textAllCaps="false"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
