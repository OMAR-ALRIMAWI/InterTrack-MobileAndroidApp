<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/companyVerificationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    tools:context=".activities.CompanyVerificationActivity">

    <LinearLayout
        android:id="@+id/companyVerificationHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_shell"
        android:paddingTop="50dp"
        android:paddingStart="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="34dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_logo_glass"
                android:padding="5dp"
                android:src="@drawable/main_logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/intertrack"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Company Supervisor Verification"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Verify your company before an admin approves the account"
            android:textColor="#CCE0FF"
            android:textSize="13sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_body_top_rounded"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/companyVerificationHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_info_box"
                android:padding="14dp"
                android:text="Please provide your company's official information and a copy of its commercial registration. The administration team will review this before approving your account."
                android:textColor="#374151"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4" />

            <!-- Company Name -->
            <TextView style="@style/CompVerLabel" android:text="Company Name *" />
            <com.google.android.material.textfield.TextInputLayout style="@style/CompVerField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompCompanyName"
                    style="@style/CompVerEdit"
                    android:hint="e.g. OpenAI Ltd." />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Company Email -->
            <TextView style="@style/CompVerLabel" android:text="Company Email *" />
            <com.google.android.material.textfield.TextInputLayout style="@style/CompVerField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompCompanyEmail"
                    style="@style/CompVerEdit"
                    android:hint="e.g. info@openai.com"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Commercial Registration Number -->
            <TextView style="@style/CompVerLabel" android:text="Commercial Registration Number *" />
            <com.google.android.material.textfield.TextInputLayout style="@style/CompVerField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompRegNumber"
                    style="@style/CompVerEdit"
                    android:hint="Company registration number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Company Address -->
            <TextView style="@style/CompVerLabel" android:text="Company Address *" />
            <com.google.android.material.textfield.TextInputLayout style="@style/CompVerField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompAddress"
                    style="@style/CompVerEdit"
                    android:hint="Street, City, Country"
                    android:inputType="textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Company Phone -->
            <TextView style="@style/CompVerLabel" android:text="Company Phone *" />
            <com.google.android.material.textfield.TextInputLayout style="@style/CompVerField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompPhone"
                    style="@style/CompVerEdit"
                    android:hint="e.g. +90 555 123 4567"
                    android:inputType="phone"
                    android:digits="+0123456789 " />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Company Website (optional) -->
            <TextView style="@style/CompVerLabel" android:text="Company Website (optional)" />
            <com.google.android.material.textfield.TextInputLayout style="@style/CompVerField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompWebsite"
                    style="@style/CompVerEdit"
                    android:hint="e.g. https://www.openai.com"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="#E9EEF5" />

            <!-- Supervisor Name -->
            <TextView style="@style/CompVerLabel" android:text="Supervisor Full Name *" />
            <com.google.android.material.textfield.TextInputLayout style="@style/CompVerField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompSupervisorName"
                    style="@style/CompVerEdit"
                    android:hint="Your full name" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Supervisor Position -->
            <TextView style="@style/CompVerLabel" android:text="Supervisor Position / Job Title *" />
            <com.google.android.material.textfield.TextInputLayout style="@style/CompVerField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompSupervisorPosition"
                    style="@style/CompVerEdit"
                    android:hint="e.g. HR Manager" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Documents section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Verification Documents"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Upload Commercial Registration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#E9EEF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_upload_document"
                        app:tint="#005FAF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Commercial Registration *"
                            android:textColor="#111827"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCompRegistrationFileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No file selected"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompUploadRegistration"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Upload"
                        android:textAllCaps="false"
                        android:textColor="#005FAF"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#005FAF"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upload Authorization letter (optional) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#E9EEF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_upload_document"
                        app:tint="#005FAF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Authorization Letter (optional)"
                            android:textColor="#111827"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCompAuthorizationFileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No file selected"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompUploadAuthorization"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Upload"
                        android:textAllCaps="false"
                        android:textColor="#005FAF"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#005FAF"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Document record only - file preview unavailable"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompSubmitVerification"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Submit for Review"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#005FAF"
                app:cornerRadius="14dp"
                app:strokeWidth="0dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
