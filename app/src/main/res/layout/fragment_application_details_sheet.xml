<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_content_rounded_top"
    android:maxHeight="640dp"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pending_pill"
            android:backgroundTint="#CBD5E1" />

        <!-- Header: avatar + name + offer + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_circle_blue"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvAppDetInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="?"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppDetName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvAppDetOfferTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvAppDetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pending"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Pending"
                android:textColor="#92400E"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Status-aware banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAppDetBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EFF6FF"
            app:strokeWidth="1dp"
            app:strokeColor="#BFDBFE">
            <TextView
                android:id="@+id/tvAppDetBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text=""
                android:textColor="#1E3A8A"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Applicant details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="APPLICANT DETAILS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_clean"
            android:padding="14dp">

            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetUniversity"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetMajor"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetYear"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetSkills"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetExperience"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Internship details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="INTERNSHIP"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_clean"
            android:padding="14dp">

            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetCompany"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetSupervisor"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetInstructor"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetApplied"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <include layout="@layout/item_app_detail_row" android:id="@+id/rowAppDetReviewed"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Rejection reason -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAppDetRejection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FEF2F2"
            app:strokeWidth="1dp"
            app:strokeColor="#FECACA">
            <TextView
                android:id="@+id/tvAppDetRejection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text=""
                android:textColor="#B91C1C"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Action buttons -->
        <LinearLayout
            android:id="@+id/llAppDetActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppDetPrimary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:text="Accept"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#16A34A"
                app:cornerRadius="12dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppDetSecondary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:text="Reject"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#DC2626"
                app:cornerRadius="12dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppDetHub"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:text="Open Internship Hub"
                android:textAllCaps="false"
                android:textColor="#005FAF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#EFF6FF"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#BFDBFE" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppDetChat"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:text="Open Progress Chat"
                android:textAllCaps="false"
                android:textColor="#005FAF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#EFF6FF"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#BFDBFE" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppDetMessage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:text="Message"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#F1F5F9"
                app:cornerRadius="12dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppDetViewCompany"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="View Company"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#F1F5F9"
                app:cornerRadius="12dp"
                app:strokeWidth="0dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
