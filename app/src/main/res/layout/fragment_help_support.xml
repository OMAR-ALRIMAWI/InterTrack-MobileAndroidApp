<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_rounded_top"
    android:clipToOutline="true"
    android:clipToPadding="false"
    android:paddingBottom="128dp"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp">

        <!-- Search bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHelpSearch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Search help topics..."
            app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="#D1D9E0" app:hintTextColor="#64748B"
            app:startIconDrawable="@drawable/ic_search" app:startIconTint="#64748B">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHelpSearch"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:textColor="#0F172A" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- FAQ section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="FREQUENTLY ASKED QUESTIONS"
            android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold"
            android:layout_marginBottom="8dp" android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF" app:strokeWidth="1dp" app:strokeColor="#E2E8F0">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- FAQ item 1 -->
                <LinearLayout android:id="@+id/faqRow1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I submit a daily report?"
                            android:textColor="#0F172A" android:textSize="14sp"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" app:tint="#9CA3AF" android:contentDescription="@null"/>
                    </LinearLayout>
                    <TextView android:id="@+id/faqAnswer1"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Go to the Reports tab, tap Submit New Report, fill in the form details including tasks, skills, and hours, then press Submit."
                        android:textColor="#64748B" android:textSize="13sp" android:lineSpacingExtra="3dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9"/>

                <!-- FAQ item 2 -->
                <LinearLayout android:id="@+id/faqRow2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I apply to a company?"
                            android:textColor="#0F172A" android:textSize="14sp"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" app:tint="#9CA3AF" android:contentDescription="@null"/>
                    </LinearLayout>
                    <TextView android:id="@+id/faqAnswer2"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Open the Companies section from the center button, browse companies, tap a company to view its profile, then press Apply to fill the internship application form."
                        android:textColor="#64748B" android:textSize="13sp" android:lineSpacingExtra="3dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9"/>

                <!-- FAQ item 3 -->
                <LinearLayout android:id="@+id/faqRow3"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I contact my instructor?"
                            android:textColor="#0F172A" android:textSize="14sp"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" app:tint="#9CA3AF" android:contentDescription="@null"/>
                    </LinearLayout>
                    <TextView android:id="@+id/faqAnswer3"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Go to Profile > Supervisor card to find your instructor. Tap the DM button on their profile to open a direct chat."
                        android:textColor="#64748B" android:textSize="13sp" android:lineSpacingExtra="3dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9"/>

                <!-- FAQ item 4 -->
                <LinearLayout android:id="@+id/faqRow4"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I track internship progress?"
                            android:textColor="#0F172A" android:textSize="14sp"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" app:tint="#9CA3AF" android:contentDescription="@null"/>
                    </LinearLayout>
                    <TextView android:id="@+id/faqAnswer4"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Go to Profile > My Internship to see your overall progress percentage, report counts, and internship timeline."
                        android:textColor="#64748B" android:textSize="13sp" android:lineSpacingExtra="3dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9"/>

                <!-- FAQ item 5 -->
                <LinearLayout android:id="@+id/faqRow5"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="How do I report a problem?"
                            android:textColor="#0F172A" android:textSize="14sp"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" app:tint="#9CA3AF" android:contentDescription="@null"/>
                    </LinearLayout>
                    <TextView android:id="@+id/faqAnswer5"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Use the Contact Support form below to describe your issue. Our support team will respond within 24 hours."
                        android:textColor="#64748B" android:textSize="13sp" android:lineSpacingExtra="3dp"
                        android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Contact support card -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CONTACT SUPPORT"
            android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold"
            android:layout_marginBottom="8dp" android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF" app:strokeWidth="1dp" app:strokeColor="#E2E8F0">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:hint="Subject"
                    app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0" app:hintTextColor="#64748B">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSupportSubject"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:textColor="#0F172A" android:textSize="14sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:hint="Describe your issue"
                    app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0" app:hintTextColor="#64748B">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSupportMessage"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textMultiLine" android:minLines="4"
                        android:gravity="top" android:textColor="#0F172A" android:textSize="14sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendSupport"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="Send Message"
                    android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp"
                    app:backgroundTint="#005FAF" app:cornerRadius="12dp" app:strokeWidth="0dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF" app:strokeWidth="1dp" app:strokeColor="#E2E8F0">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="About InterTrack"
                    android:textColor="#0F172A" android:textSize="15sp" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="InterTrack is your all-in-one internship management platform connecting students, instructors, and companies."
                    android:textColor="#64748B" android:textSize="13sp" android:lineSpacingExtra="3dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Version 1.0.0"
                    android:textColor="#94A3B8" android:textSize="12sp" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
