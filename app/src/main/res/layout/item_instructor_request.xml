<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Student header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icon_circle_blue"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvReqItemInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="?"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReqItemName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Name"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReqItemInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Major"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReqItemUniversity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="University"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvReqItemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pending"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="New"
                android:textColor="#92400E"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Company row (hidden if blank) -->
        <LinearLayout
            android:id="@+id/llReqItemCompanyRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Company"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvReqItemCompany"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text=""
                android:textColor="#374151"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Rejection reason (shown when REJECTED) -->
        <TextView
            android:id="@+id/tvReqItemRejectionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Message button (shown only when ACCEPTED) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMessageReqItem"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Message"
            android:textColor="#0569bf"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:visibility="gone"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="#0569bf"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp" />

        <!-- Action buttons (shown only when PENDING) -->
        <LinearLayout
            android:id="@+id/llReqItemActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptReqItem"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Accept"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:backgroundTint="#16A34A"
                app:cornerRadius="10dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeclineReqItem"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Decline"
                android:textColor="#DC2626"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#DC2626"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
