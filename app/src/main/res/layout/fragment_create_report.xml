<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:clipToPadding="false"
    android:paddingBottom="32dp"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- In-fragment header (shared header hidden for this page) -->
        <LinearLayout
            android:id="@+id/createReportHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_shell"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="52dp"
            android:paddingBottom="20dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnCreateReportBack"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_header_icon_glass"
                android:padding="10dp"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Report"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log your daily internship activity"
                    android:textColor="#CCE0FF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Weekly period info card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#EFF6FF"
            app:strokeWidth="1dp"
            app:strokeColor="#BFDBFE">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tvReportPeriodInfo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Internship period: —"
                    android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvReportWeekInfo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Week — · Deadline —"
                    android:textColor="#334155" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvReportCountInfo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Reports submitted: —"
                    android:textColor="#005FAF" android:textSize="13sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvReportBlockedReason"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textColor="#DC2626" android:textSize="13sp" android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Form card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report Details"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <!-- Report Title -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReportTitle"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Report Title *"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0"
                    app:hintTextColor="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReportTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#0F172A"
                        android:textSize="14sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Report Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReportDate"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Report Date *"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0"
                    app:hintTextColor="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReportDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:hint="e.g. 2024-06-01"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Internship Company -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReportCompany"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Internship Company *"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0"
                    app:hintTextColor="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReportCompany"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#0F172A"
                        android:textSize="14sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Hours Worked -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHoursWorked"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Hours Worked"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0"
                    app:hintTextColor="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHoursWorked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="#0F172A"
                        android:textSize="14sp"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Activity card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Activity"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <!-- Tasks Completed -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTasksCompleted"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Tasks Completed *"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0"
                    app:hintTextColor="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTasksCompleted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:gravity="top"
                        android:textColor="#0F172A"
                        android:textSize="14sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Skills Practiced -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSkillsPracticed"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Skills Practiced"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0"
                    app:hintTextColor="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSkillsPracticed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:gravity="top"
                        android:textColor="#0F172A"
                        android:textSize="14sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Challenges Faced -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilChallengesFaced"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Challenges Faced"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0"
                    app:hintTextColor="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etChallengesFaced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:gravity="top"
                        android:textColor="#0F172A"
                        android:textSize="14sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Progress Notes -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProgressNotes"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:hint="Progress Notes"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#D1D9E0"
                    app:hintTextColor="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProgressNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:gravity="top"
                        android:textColor="#0F172A"
                        android:textSize="14sp"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Attachment placeholder card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attachment (Optional)"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAttachFile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Attach File"
                    android:textAllCaps="false"
                    android:textColor="#0569BF"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#0569BF"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_upload_document"
                    app:iconTint="#0569BF"
                    app:iconGravity="textStart"/>

                <TextView
                    android:id="@+id/tvAttachedFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No file attached"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:visibility="visible"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitReport"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Submit Report"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#005FAF"
                app:cornerRadius="14dp"
                app:strokeWidth="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelReport"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#64748B"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
