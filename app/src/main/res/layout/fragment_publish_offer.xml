<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_rounded_top"
    android:clipToOutline="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp">

        <!-- Form card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Internship Details"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Position Title" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOfferTitle"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. Mobile App Development Intern"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Department" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOfferDepartment"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. Engineering"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Duration (weeks)" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOfferDuration"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. 12"
                    android:inputType="number"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Max Applicants" android:textColor="#374151"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOfferMaxApps"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. 5"
                    android:inputType="number"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Description card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description &amp; Requirements"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOfferDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:hint="Describe the internship role, tasks, and what the intern will learn..."
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOfferRequirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:hint="Required skills, year level, GPA, etc."
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:textColor="#111827" android:textColorHint="#9CA3AF" android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Publish button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishOffer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:text="Publish Offer"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="#005FAF"
            app:strokeWidth="0dp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelOffer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textAllCaps="false"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
